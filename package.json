{
  "name": "lense-visual-control",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/prepare-site-downloads.mjs && node scripts/prepare-documentation.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:release": "node --test scripts/prepare-site-downloads.test.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm test && pnpm test:release && pnpm test:assets && pnpm build && pnpm test:e2e",
    "test:assets": "node --test scripts/brand-assets.test.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "idb": "^8.0.3",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.2.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  },
  "packageManager": "pnpm@10.15.1",
  "license": "MIT"
}
